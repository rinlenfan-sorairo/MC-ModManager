<UserControl x:Class="MC_ModManager.Views.HomeTabContents"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MC_ModManager.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <StackPanel Margin="16">
        <TextBlock Margin="0,0,0,8" Style="{StaticResource MaterialDesignHeadline5TextBlock}" Text="  MC - ModManager" />
        <TextBlock Margin="0,0,0,32" FontStyle="Italic" Text="　このソフトはマインクラフトのMODの管理を行えるソフトです。"/>
        <TextBlock TextWrapping="Wrap" Text="このアプリは、MinecraftのMODを簡単に管理できるツールです。MODのインストール、削除、更新をワンクリックで行うことができ、MODのバージョン管理や互換性のチェックもサポートしています。また、アプリ内でMODの設定変更やバックアップ機能も搭載しているため、安心してゲーム環境をカスタマイズできます。"/>
    </StackPanel>
</UserControl>
