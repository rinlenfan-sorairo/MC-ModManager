<UserControl x:Class="MC_ModManager.Views.SettingsTabContents"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MC_ModManager.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Minecraft 実行ファイルパス:" VerticalAlignment="Center" Grid.Column="0" Margin="5,0,5,0" Height="16"/>
        <TextBox x:Name="MinecraftPathTextBox" Grid.Row="0" Grid.Column="1" Margin="5,5,5,5"/>
        <Button Content="    参照...    " Grid.Row="0" Grid.Column="2" Margin="5,5,5,5" Click="BrowseButton_Click" Tag="MinecraftPathTextBox"/>
        <TextBlock Text="Minecraft AppDataパス:" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" Margin="5,0,5,0" Height="16"/>
        <TextBox x:Name="MinecraftAppDataPathTextBox" Grid.Row="1" Grid.Column="1" Margin="5,5,5,5"/>
        <Button Content="    参照...    " Grid.Row="1" Grid.Column="2" Margin="5,5,5,5" Click="BrowseButton_Click" Tag="MinecraftAppDataPathTextBox"/>
        <Button Content="Save" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left" Click="SaveButton_Click" Width="61"/>
    </Grid>
</UserControl>
